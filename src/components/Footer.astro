---
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-mountains" aria-hidden="true">
		<img src="/mountains.svg" alt="" width="1200" height="120" />
	</div>
	<div class="footer-body">
		<div class="footer-inner">
			<div class="footer-brand">
				<span class="footer-logo">
					<span class="logo-a">a</span><span class="logo-w">w</span>
				</span>
				<p class="footer-tagline">Making civic education approachable for everyone.</p>
			</div>
			<div class="footer-links">
				<a href="/">Home</a>
				<a href="/blog">Blog</a>
				<a href="/about">About</a>
				<a href="https://github.com/Anywell-Software" target="_blank" rel="noopener noreferrer">GitHub</a>
			</div>
		</div>
		<p class="footer-copy">&copy; {today.getFullYear()} Anywell. All rights reserved.</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: var(--space-16);
		overflow: hidden;
	}

	.footer-mountains {
		display: block;
		line-height: 0;
	}
	.footer-mountains img {
		display: block;
		width: 100%;
		height: 120px;
		object-fit: cover;
		object-position: center bottom;
		border-radius: 0;
	}

	.footer-body {
		background: var(--violet-700);
		color: var(--text-on-dark);
		padding: var(--space-8) var(--gutter) var(--space-10);
	}

	.footer-inner {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-8);
		max-width: var(--container-max);
		margin: 0 auto var(--space-8);
		flex-wrap: wrap;
	}

	.footer-brand { display: flex; flex-direction: column; gap: var(--space-2); }

	.footer-logo {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 1.5rem;
		letter-spacing: -0.03em;
	}
	.logo-a { color: rgba(255,255,255,0.6); }
	.logo-w { color: #ffffff; }

	.footer-tagline {
		margin: 0;
		font-size: var(--text-sm);
		color: rgba(255,255,255,0.7);
		max-width: 260px;
	}

	.footer-links {
		display: flex;
		align-items: center;
		gap: var(--space-5);
		flex-wrap: wrap;
	}
	.footer-links a {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-sm);
		color: rgba(255,255,255,0.75);
		text-decoration: none;
		transition: color var(--dur-base);
	}
	.footer-links a:hover { color: #ffffff; text-decoration: none; }

	.footer-copy {
		margin: 0;
		font-size: var(--text-xs);
		color: rgba(255,255,255,0.5);
		text-align: center;
	}
</style>
