---
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="site-nav">
		<a href="/" class="logo" aria-label="Anywell home">
			<span class="logo-a">a</span><span class="logo-w">w</span>
		</a>
		<div class="nav-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="nav-actions">
			<a
				href="https://github.com/Anywell-Software"
				target="_blank"
				rel="noopener noreferrer"
				class="nav-icon"
				aria-label="Anywell on GitHub"
			>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(248, 247, 247, 0.92);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border-subtle);
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 0 var(--gutter);
		height: 60px;
	}

	.logo {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 1.75rem;
		line-height: 1;
		text-decoration: none;
		letter-spacing: -0.03em;
		flex: none;
	}
	.logo-a { color: var(--stone-500); }
	.logo-w { color: var(--color-primary); }
	.logo:hover { text-decoration: none; }
	.logo:hover .logo-a { color: var(--stone-700); }
	.logo:hover .logo-w { color: var(--color-primary-hover); }

	.nav-links {
		display: flex;
		align-items: center;
		gap: var(--space-1);
	}

	/* HeaderLink styles applied via global slot */
	.nav-links :global(a) {
		display: inline-flex;
		align-items: center;
		height: 36px;
		padding: 0 var(--space-3);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-sm);
		color: var(--text-muted);
		text-decoration: none;
		border-radius: var(--radius-sm);
		transition: color var(--dur-base), background var(--dur-base);
	}
	.nav-links :global(a:hover) {
		color: var(--text-strong);
		background: var(--stone-100);
		text-decoration: none;
	}
	.nav-links :global(a.active) {
		color: var(--color-primary);
		background: var(--violet-50);
		font-weight: 800;
	}

	.nav-actions {
		margin-left: auto;
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.nav-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		color: var(--text-muted);
		border-radius: var(--radius-sm);
		transition: color var(--dur-base), background var(--dur-base);
	}
	.nav-icon:hover {
		color: var(--text-strong);
		background: var(--stone-100);
		text-decoration: none;
	}

	@media (max-width: 480px) {
		.nav-links :global(a) { font-size: var(--text-2xs); padding: 0 var(--space-2); }
	}
</style>
