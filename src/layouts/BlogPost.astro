---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { LANGUAGES, type Lang } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	lang: Lang;
	translations: { lang: Lang; href: string }[];
};

const { title, description, pubDate, updatedDate, heroImage, lang, translations } = Astro.props;
---

<html lang={lang}>
	<head>
		<BaseHead title={`${title} — Anywell`} description={description} image={heroImage} />
		{translations.map((t) => (
			<link rel="alternate" hreflang={t.lang} href={new URL(t.href, Astro.site)} />
		))}
	</head>

	<body>
		<Header />

		<main>
			<article>
				<div class="post-hero">
					<div class="container container--narrow">
						<p class="eyebrow post-meta">
							<FormattedDate date={pubDate} />
							{updatedDate && (
								<span class="updated-on">
									· Updated <FormattedDate date={updatedDate} />
								</span>
							)}
						</p>
						{translations.length > 1 && (
							<nav class="lang-switch" aria-label="Language">
								<svg class="lang-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
									<circle cx="12" cy="12" r="9" />
									<path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z" />
								</svg>
								{translations.map((t) => (
									<a
										href={t.href}
										hreflang={t.lang}
										lang={t.lang}
										title={LANGUAGES[t.lang]}
										aria-label={LANGUAGES[t.lang]}
										aria-current={t.lang === lang ? 'page' : undefined}
									>
										{t.lang.toUpperCase()}
									</a>
								))}
							</nav>
						)}
						<h1>{title}</h1>
						<p class="lead">{description}</p>
					</div>
				</div>

				{heroImage && (
					<div class="hero-image">
						<Image
							width={1200}
							height={480}
							src={heroImage}
							alt=""
							class="hero-img"
						/>
					</div>
				)}

				<div class="prose">
					<slot />
				</div>
			</article>
		</main>

		<Footer />
	</body>
</html>

<style>
	.hero-image {
		width: 100%;
		max-height: 480px;
		overflow: hidden;
		background: var(--violet-100);
	}
	.hero-img {
		display: block;
		width: 100%;
		max-height: 480px;
		object-fit: cover;
		border-radius: 0;
		box-shadow: none;
	}

	.post-hero {
		background: linear-gradient(160deg, var(--violet-50) 0%, var(--violet-100) 100%);
		padding: var(--space-12) 0 var(--space-10);
		border-bottom: 1px solid var(--border-subtle);
	}
	.post-hero h1 {
		margin-top: var(--space-3);
		color: var(--violet-900);
	}

	.post-meta { margin: 0 0 var(--space-4); }

	.updated-on { font-style: italic; }

	.lead {
		font-size: var(--text-lg);
		color: var(--text-body);
		line-height: var(--leading-normal);
		margin: 0;
	}

	.lang-switch {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		padding: var(--space-1);
		margin-bottom: var(--space-5);
		background: rgba(255, 255, 255, 0.55);
		border: 1px solid var(--violet-200);
		border-radius: var(--radius-pill);
	}
	.lang-icon {
		margin: 0 var(--space-1) 0 var(--space-2);
		fill: none;
		stroke: var(--violet-700);
		stroke-width: 1.75;
	}
	.lang-switch a {
		min-width: 2.75rem;
		padding: var(--space-1) var(--space-3);
		border-radius: var(--radius-pill);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: var(--weight-black);
		letter-spacing: var(--tracking-wide);
		text-align: center;
		color: var(--text-muted);
		text-decoration: none;
		transition: background var(--dur-base) var(--ease-standard),
		            color var(--dur-base) var(--ease-standard),
		            box-shadow var(--dur-base) var(--ease-standard);
	}
	.lang-switch a:hover {
		color: var(--color-primary-hover);
		background: var(--violet-50);
	}
	.lang-switch a:focus-visible {
		outline: none;
		box-shadow: var(--shadow-focus);
	}
	.lang-switch a[aria-current='page'] {
		background: var(--surface-card);
		color: var(--color-primary-press);
		box-shadow: var(--shadow-sm), 0 0 0 1px var(--violet-200);
		pointer-events: none;
	}

</style>
