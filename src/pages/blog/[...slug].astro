---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { LANGUAGES } from '../../consts';
import { getLang, getTranslationKey } from '../../i18n';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

const key = getTranslationKey(post);
const translations = (await getCollection('blog'))
	.filter((p) => getTranslationKey(p) === key)
	.map((p) => ({ lang: getLang(p), href: `/blog/${p.id}/` }))
	.sort((a, b) => Object.keys(LANGUAGES).indexOf(a.lang) - Object.keys(LANGUAGES).indexOf(b.lang));
---

<BlogPost {...post.data} lang={getLang(post)} translations={translations}>
	<Content />
</BlogPost>
